<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alfajores BBB - Sistema de Colección y Sorteo</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- HTML5 QR Code Scanner Library -->
  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&display=swap');
    
    body {
      font-family: 'Outfit', sans-serif;
      background-color: #1a0f1d;
      color: #fff8f0;
    }

    .bg-chocolate { background-color: #2A1810; }
    .bg-caramel { background-color: #C67D33; }
    .text-caramel { color: #C67D33; }
    .border-caramel { border-color: #C67D33; }

    .glow-effect {
      box-shadow: 0 0 25px rgba(198, 125, 51, 0.4);
    }

    .card-gradient {
      background: linear-gradient(135deg, #3B2219 0%, #2A1810 100%);
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #1a0f1d; }
    ::-webkit-scrollbar-thumb { background: #C67D33; border-radius: 4px; }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Header / Navigation -->
  <header class="bg-chocolate border-b border-caramel/30 sticky top-0 z-50 px-4 py-3 shadow-lg">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-caramel flex items-center justify-center font-extrabold text-chocolate text-xl shadow">
          BBB
        </div>
        <div>
          <h1 class="font-extrabold text-lg leading-none tracking-wide text-amber-200">ALFAJORES BBB</h1>
          <p class="text-xs text-amber-400/80">Ediciones Limitadas & Virales</p>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex gap-2 bg-black/40 p-1 rounded-xl border border-white/10 text-xs md:text-sm">
        <button onclick="switchTab('screen')" id="tab-screen" class="px-3 py-1.5 rounded-lg transition font-semibold bg-caramel text-chocolate">
          🖥️ Pantalla Expo
        </button>
        <button onclick="switchTab('app')" id="tab-app" class="px-3 py-1.5 rounded-lg transition font-semibold hover:bg-white/10 text-amber-100">
          📱 App Escáner
        </button>
        <button onclick="switchTab('master')" id="tab-master" class="px-3 py-1.5 rounded-lg transition font-semibold hover:bg-white/10 text-amber-100">
          🏆 Panel Maestro
        </button>
      </nav>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-6xl w-full mx-auto p-4 flex flex-col">

    <!-- ========================================== -->
    <!-- VIEW 1: PANTALLA PRINCIPAL DE LA EXPOSICIÓN -->
    <!-- ========================================== -->
    <section id="view-screen" class="flex-1 flex flex-col gap-6">
      <div class="text-center space-y-2">
        <span class="bg-caramel/20 text-amber-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider border border-caramel/40">
          Experiencia Interactiva de Exposición
        </span>
        <h2 class="text-3xl md:text-5xl font-black text-amber-100">¡Coleccioná tus Alfajores BBB!</h2>
        <p class="text-amber-200/70 max-w-xl mx-auto text-sm md:text-base">
          Escanéa el QR de acceso con tu celular, descubrí los 4 empaques exhibidos en la pantalla para añadirlos a tu colección y participá automáticamente del sorteo en vivo.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-center my-auto">
        <!-- QR Access Banner (Único para los participantes) -->
        <div class="card-gradient p-6 rounded-3xl border-2 border-caramel/50 text-center flex flex-col items-center justify-center glow-effect space-y-4">
          <h3 class="text-xl font-bold text-amber-200">1. Escanéa este QR para entrar</h3>
          <p class="text-xs text-amber-100/70">Abre la aplicación interactiva en tu teléfono celular</p>
          
          <div class="bg-white p-4 rounded-2xl shadow-2xl">
            <img id="access-qr-code" src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https://alfajoresbbb.app/join" alt="QR Acceso App" class="w-44 h-44">
          </div>

          <div class="bg-black/30 px-4 py-2 rounded-xl text-xs text-amber-300 font-mono border border-white/5">
            https://alfajoresbbb.app/join
          </div>
        </div>

        <!-- Displays of Packaging to Scan -->
        <div class="lg:col-span-2 space-y-4">
          <div class="flex justify-between items-center">
            <h3 class="text-lg font-bold text-amber-100 flex items-center gap-2">
              <span>📷</span> 2. Escanéa estos 4 alfajores del archivo con la App:
            </h3>
            <span class="text-xs bg-amber-500/20 text-amber-300 px-2.5 py-1 rounded-lg border border-amber-500/30">Archivos Oficiales del Packaging</span>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <!-- Packaging Item 1 -->
            <div class="card-gradient border border-white/10 rounded-2xl p-3 flex flex-col items-center text-center space-y-2 hover:border-caramel transition">
              <div class="w-full h-36 rounded-xl bg-black/40 overflow-hidden relative flex items-center justify-center p-2">
                <img src="http://googleusercontent.com/lmdx_content/pwOFASkmtpUOwLUdxBBZwsioiPNNPNYlreohTamuYkTaOjyHbxAYDhzIqhKpRtTJZEAIqxZdAoVaXDLjLZlWkyzDBgKuUFVqWbpOQYvUKWyNCXuuDCIOvGFHzMdNWdpjWFcNuJojkIqRfatgVXstkFsdNswQChTIRljaNI35254" 
                     alt="Verity Vainilla" class="max-h-full object-contain">
                <span class="absolute top-2 left-2 bg-amber-500 text-chocolate font-black text-[10px] px-2 py-0.5 rounded">ID: 01</span>
              </div>
              <h4 class="font-bold text-sm text-amber-200">Verity Vainilla</h4>
            </div>

            <!-- Packaging Item 2 -->
            <div class="card-gradient border border-white/10 rounded-2xl p-3 flex flex-col items-center text-center space-y-2 hover:border-caramel transition">
              <div class="w-full h-36 rounded-xl bg-black/40 overflow-hidden relative flex items-center justify-center p-2">
                <img src="http://googleusercontent.com/lmdx_content/rLVDoEuXOAZxxmPOPclymqWGZDrhMonqhVtzQhjsIKHcQQrfAUZrlvJQEozGVHynUjlQdNIHygeEaGZpcPVZgKRdZCNOPNxSXIQThmaCxxnUVYqgQALAFgTNbHrYsgbtNZQACDlJFwHwdvyOoyYUAYfOiNsXrSphiDwZAyasyBcPGJnZrGPlaqBuPmItt35250" 
                     alt="Caramelo Pink 67" class="max-h-full object-contain">
                <span class="absolute top-2 left-2 bg-pink-500 text-white font-black text-[10px] px-2 py-0.5 rounded">ID: 02</span>
              </div>
              <h4 class="font-bold text-sm text-pink-200">Caramelo Pink 67</h4>
            </div>

            <!-- Packaging Item 3 -->
            <div class="card-gradient border border-white/10 rounded-2xl p-3 flex flex-col items-center text-center space-y-2 hover:border-caramel transition">
              <div class="w-full h-36 rounded-xl bg-black/40 overflow-hidden relative flex items-center justify-center p-2">
                <img src="http://googleusercontent.com/image_generation_content/4_626" 
                     alt="Alfajor 3xT 3 Capas" class="max-h-full object-contain">
                <span class="absolute top-2 left-2 bg-amber-600 text-white font-black text-[10px] px-2 py-0.5 rounded">ID: 03</span>
              </div>
              <h4 class="font-bold text-sm text-amber-200">BBB 3xT Triple Capa</h4>
            </div>

            <!-- Packaging Item 4 -->
            <div class="card-gradient border border-white/10 rounded-2xl p-3 flex flex-col items-center text-center space-y-2 hover:border-caramel transition">
              <div class="w-full h-36 rounded-xl bg-black/40 overflow-hidden relative flex items-center justify-center p-2">
                <img src="http://googleusercontent.com/image_generation_content/9_630" 
                     alt="Aura Galáctica" class="max-h-full object-contain">
                <span class="absolute top-2 left-2 bg-purple-500 text-white font-black text-[10px] px-2 py-0.5 rounded">ID: 04</span>
              </div>
              <h4 class="font-bold text-sm text-purple-200">Aura Galáctica +1000</h4>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ========================================== -->
    <!-- VIEW 2: APLICACIÓN CELULAR DEL USUARIO     -->
    <!-- ========================================== -->
    <section id="view-app" class="hidden flex-1 flex justify-center py-2">
      <div class="w-full max-w-md bg-chocolate border-4 border-amber-900/60 rounded-[3rem] shadow-2xl p-4 flex flex-col justify-between relative overflow-hidden">
        
        <div class="w-32 h-4 bg-black rounded-b-xl mx-auto mb-2"></div>

        <!-- User Profile Bar -->
        <div class="bg-black/40 rounded-2xl p-3 flex justify-between items-center border border-white/10 mb-3">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-caramel flex items-center justify-center font-bold text-chocolate text-xs">
              👤
            </div>
            <div>
              <input type="text" id="user-name-input" value="Visitante #1042" onchange="updateUserName(this.value)" 
                     class="bg-transparent text-sm font-bold text-amber-200 border-b border-amber-500/30 focus:outline-none focus:border-caramel w-32">
              <p class="text-[10px] text-emerald-400 font-semibold" id="raffle-status-badge">● Registrado en Sorteo</p>
            </div>
          </div>
          <div class="text-right">
            <p class="text-[10px] text-amber-100/60">Colección</p>
            <p class="text-xs font-black text-amber-300" id="collection-count">0 / 4 Alfajores</p>
          </div>
        </div>

        <!-- Tab Switching within Mobile App -->
        <div class="flex bg-black/50 p-1 rounded-xl mb-3 border border-white/5 text-xs">
          <button onclick="switchAppTab('collection')" id="app-tab-coll" class="flex-1 py-1.5 rounded-lg bg-caramel text-chocolate font-bold">
            🎒 Mi Colección
          </button>
          <button onclick="switchAppTab('scanner')" id="app-tab-scan" class="flex-1 py-1.5 rounded-lg text-amber-200 font-bold hover:bg-white/5">
            📷 Escanear
          </button>
        </div>

        <!-- APP CONTENT AREA -->
        <div class="flex-1 overflow-y-auto space-y-3">

          <!-- APP SUB-VIEW: COLLECTION -->
          <div id="app-sub-collection" class="space-y-3">
            <div class="text-center py-2">
              <h3 class="font-extrabold text-amber-100">Colección de Alfajores BBB</h3>
              <p class="text-xs text-amber-200/60">Escanéa los empaques de la pantalla para coleccionarlos</p>
            </div>

            <div class="grid grid-cols-2 gap-3" id="collection-grid"></div>
          </div>

          <!-- APP SUB-VIEW: SCANNER -->
          <div id="app-sub-scanner" class="hidden space-y-3 flex flex-col items-center">
            <div class="text-center">
              <h3 class="font-extrabold text-amber-100">Escáner de Empaques</h3>
              <p class="text-xs text-amber-200/60">Usa el simulador para añadir productos</p>
            </div>

            <div class="w-full bg-black/60 rounded-2xl border-2 border-dashed border-caramel/50 p-3 flex flex-col items-center justify-center relative min-h-[160px]">
              <div id="reader" class="w-full rounded-xl overflow-hidden"></div>
              <div id="scanner-instructions" class="text-center space-y-2 py-2">
                <span class="text-2xl">📷</span>
                <p class="text-xs text-amber-200/80">Simulador de cámara activo</p>
              </div>
            </div>

            <div id="scan-feedback" class="hidden w-full p-3 rounded-xl text-xs text-center font-bold"></div>

            <div class="w-full bg-black/30 p-3 rounded-2xl border border-white/10 space-y-2">
              <p class="text-[11px] font-bold text-amber-300 text-center uppercase tracking-wider">Simulador de Escaneo por Foto</p>
              <div class="grid grid-cols-2 gap-2">
                <button onclick="processScannedItem('verity')" class="p-2 bg-amber-900/40 hover:bg-amber-800/60 border border-amber-500/30 rounded-xl text-[11px] font-semibold text-amber-100 transition text-left">
                  🍪 Scan: Verity Vainilla
                </button>
                <button onclick="processScannedItem('caramelo')" class="p-2 bg-pink-900/40 hover:bg-pink-800/60 border border-pink-500/30 rounded-xl text-[11px] font-semibold text-pink-100 transition text-left">
                  🍬 Scan: Caramelo 67
                </button>
                <button onclick="processScannedItem('3xt')" class="p-2 bg-amber-950/40 hover:bg-amber-800/60 border border-amber-600/30 rounded-xl text-[11px] font-semibold text-amber-200 transition text-left">
                  🍫 Scan: BBB 3xT
                </button>
                <button onclick="processScannedItem('aura')" class="p-2 bg-purple-900/40 hover:bg-purple-800/60 border border-purple-500/30 rounded-xl text-[11px] font-semibold text-purple-100 transition text-left">
                  ✨ Scan: Aura Galáctica
                </button>
              </div>
            </div>

          </div>

        </div>

        <!-- Enlace Externo a la App Maestra (En vez de QR) -->
        <div class="mt-3 pt-2 border-t border-white/10 text-center">
          <a href="#" onclick="switchTab('master'); return false;" class="text-[11px] text-amber-400 hover:underline font-semibold flex items-center justify-center gap-1">
            <span>🔗</span> [Ir al Panel Maestro del Sorteo (Solo Organizadores)]
          </a>
        </div>

      </div>
    </section>


    <!-- ========================================== -->
    <!-- VIEW 3: PANEL MAESTRO Y SORTEO             -->
    <!-- ========================================== -->
    <section id="view-master" class="hidden flex-1 flex flex-col gap-6">
      <div class="flex justify-between items-center border-b border-caramel/30 pb-4">
        <div>
          <span class="bg-purple-500/20 text-purple-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider border border-purple-500/30">
            Panel de Control Maestro
          </span>
          <h2 class="text-2xl md:text-3xl font-black text-amber-100 mt-1">Sorteo en Vivo de Alfajores BBB</h2>
        </div>

        <button onclick="triggerRaffle()" id="raffle-btn" class="bg-gradient-to-r from-amber-500 to-caramel text-chocolate font-black px-6 py-3 rounded-2xl shadow-lg hover:brightness-110 active:scale-95 transition flex items-center gap-2">
          <span>🎁</span> REALIZAR SORTEO
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Participants List with Delete option -->
        <div class="card-gradient p-5 rounded-2xl border border-white/10 space-y-3">
          <div class="flex justify-between items-center">
            <h3 class="font-bold text-amber-200 text-sm">Participantes Habilitados</h3>
            <span class="text-xs bg-black/40 px-2 py-1 rounded text-amber-300 font-mono" id="participant-counter">1 Participante</span>
          </div>
          <p class="text-[11px] text-amber-100/60">Aquí puedes supervisar y quitar participantes si es necesario.</p>
          
          <div class="space-y-2 max-h-60 overflow-y-auto pr-1" id="participants-list"></div>
        </div>

        <!-- Live Raffle Display -->
        <div class="md:col-span-2 card-gradient border-2 border-caramel/40 rounded-3xl p-6 flex flex-col items-center justify-center text-center space-y-4 glow-effect relative overflow-hidden">
          <h3 class="text-lg font-bold text-amber-300 uppercase tracking-widest">Resultado del Sorteo</h3>

          <div id="raffle-box" class="w-full max-w-md bg-black/50 border border-white/10 p-6 rounded-2xl flex flex-col items-center space-y-3 min-h-[180px] justify-center">
            <span class="text-4xl">🎰</span>
            <p class="text-amber-100/70 text-sm">Presiona "REALIZAR SORTEO" para seleccionar un ganador entre la audiencia de la exposición.</p>
          </div>

          <div class="text-xs text-amber-100/50">
            * El ganador se lleva una caja coleccionable de ediciones especiales de Alfajores BBB.
          </div>
        </div>
      </div>
    </section>

  </main>

  <script>
    const PACKAGING_DB = {
      'verity': { id: 'verity', name: 'Verity Vainilla', flavor: 'Vainilla & Galleta Dorada', image: 'http://googleusercontent.com/lmdx_content/pwOFASkmtpUOwLUdxBBZwsioiPNNPNYlreohTamuYkTaOjyHbxAYDhzIqhKpRtTJZEAIqxZdAoVaXDLjLZlWkyzDBgKuUFVqWbpOQYvUKWyNCXuuDCIOvGFHzMdNWdpjWFcNuJojkIqRfatgVXstkFsdNswQChTIRljaNI35254' },
      'caramelo': { id: 'caramelo', name: 'Caramelo Pink 67', flavor: 'Caramelo Rosado & Dulce de Leche', image: 'http://googleusercontent.com/lmdx_content/rLVDoEuXOAZxxmPOPclymqWGZDrhMonqhVtzQhjsIKHcQQrfAUZrlvJQEozGVHynUjlQdNIHygeEaGZpcPVZgKRdZCNOPNxSXIQThmaCxxnUVYqgQALAFgTNbHrYsgbtNZQACDlJFwHwdvyOoyYUAYfOiNsXrSphiDwZAyasyBcPGJnZrGPlaqBuPmItt35250' },
      '3xt': { id: '3xt', name: 'BBB 3xT Triple Capa', flavor: 'Triple Galleta & Cacao', image: 'http://googleusercontent.com/image_generation_content/4_626' },
      'aura': { id: 'aura', name: 'Aura Galáctica +1000', flavor: 'Edición Limitada Cacao Espacial', image: 'http://googleusercontent.com/image_generation_content/9_630' }
    };

    let currentUser = {
      name: 'Visitante #1042',
      collection: []
    };

    let simulatedParticipants = [
      { name: 'Visitante #1042', count: 0 },
      { name: 'Camila Rossi', count: 3 },
      { name: 'Lucas Benítez', count: 4 },
      { name: 'Sofía Martínez', count: 2 },
      { name: 'Mateo Gómez', count: 4 }
    ];

    function switchTab(tab) {
      document.getElementById('view-screen').classList.add('hidden');
      document.getElementById('view-app').classList.add('hidden');
      document.getElementById('view-master').classList.add('hidden');

      document.getElementById('tab-screen').className = "px-3 py-1.5 rounded-lg transition font-semibold hover:bg-white/10 text-amber-100";
      document.getElementById('tab-app').className = "px-3 py-1.5 rounded-lg transition font-semibold hover:bg-white/10 text-amber-100";
      document.getElementById('tab-master').className = "px-3 py-1.5 rounded-lg transition font-semibold hover:bg-white/10 text-amber-100";

      if (tab === 'screen') {
        document.getElementById('view-screen').classList.remove('hidden');
        document.getElementById('tab-screen').className = "px-3 py-1.5 rounded-lg transition font-semibold bg-caramel text-chocolate";
      } else if (tab === 'app') {
        document.getElementById('view-app').classList.remove('hidden');
        document.getElementById('tab-app').className = "px-3 py-1.5 rounded-lg transition font-semibold bg-caramel text-chocolate";
        renderCollection();
      } else if (tab === 'master') {
        document.getElementById('view-master').classList.remove('hidden');
        document.getElementById('tab-master').className = "px-3 py-1.5 rounded-lg transition font-semibold bg-caramel text-chocolate";
        renderParticipants();
      }
    }

    function switchAppTab(subtab) {
      document.getElementById('app-sub-collection').classList.add('hidden');
      document.getElementById('app-sub-scanner').classList.add('hidden');

      document.getElementById('app-tab-coll').className = "flex-1 py-1.5 rounded-lg text-amber-200 font-bold hover:bg-white/5";
      document.getElementById('app-tab-scan').className = "flex-1 py-1.5 rounded-lg text-amber-200 font-bold hover:bg-white/5";

      if (subtab === 'collection') {
        document.getElementById('app-sub-collection').classList.remove('hidden');
        document.getElementById('app-tab-coll').className = "flex-1 py-1.5 rounded-lg bg-caramel text-chocolate font-bold";
        renderCollection();
      } else {
        document.getElementById('app-sub-scanner').classList.remove('hidden');
        document.getElementById('app-tab-scan').className = "flex-1 py-1.5 rounded-lg bg-caramel text-chocolate font-bold";
      }
    }

    function updateUserName(newName) {
      currentUser.name = newName || 'Visitante Anónimo';
      let p = simulatedParticipants.find(p => p.name.includes('#1042') || p.name === currentUser.name);
      if (p) p.name = currentUser.name;
      renderParticipants();
    }

    function renderCollection() {
      const grid = document.getElementById('collection-grid');
      grid.innerHTML = '';

      Object.keys(PACKAGING_DB).forEach(key => {
        const item = PACKAGING_DB[key];
        const isCollected = currentUser.collection.includes(key);

        const card = document.createElement('div');
        card.className = `p-3 rounded-2xl border ${isCollected ? 'border-caramel/80 bg-black/40' : 'border-white/5 bg-black/20 opacity-50'} flex flex-col items-center text-center relative transition`;

        card.innerHTML = `
          ${isCollected 
            ? `<span class="absolute top-2 right-2 bg-emerald-500 text-black text-[9px] font-black px-1.5 py-0.5 rounded-full">¡CONSEGUIDO!</span>` 
            : `<span class="absolute top-2 right-2 bg-gray-700 text-gray-300 text-[9px] font-bold px-1.5 py-0.5 rounded-full">BLOQUEADO</span>`}
          
          <div class="w-full h-24 rounded-xl bg-black/50 overflow-hidden flex items-center justify-center p-1 mb-2">
            <img src="${item.image}" alt="${item.name}" class="max-h-full object-contain ${isCollected ? '' : 'filter grayscale blur-[1px]'}">
          </div>
          
          <h4 class="font-bold text-xs text-amber-100">${item.name}</h4>
        `;

        grid.appendChild(card);
      });

      document.getElementById('collection-count').innerText = `${currentUser.collection.length} / ${Object.keys(PACKAGING_DB).length} Alfajores`;
      
      let me = simulatedParticipants.find(p => p.name === currentUser.name);
      if (me) me.count = currentUser.collection.length;
    }

    function processScannedItem(itemId) {
      const feedback = document.getElementById('scan-feedback');
      feedback.classList.remove('hidden', 'bg-red-500/20', 'border-red-500', 'text-red-300', 'bg-emerald-500/20', 'border-emerald-500', 'text-emerald-300');

      if (!PACKAGING_DB[itemId]) return;

      if (currentUser.collection.includes(itemId)) {
        feedback.className = "w-full p-3 rounded-xl text-xs text-center font-bold bg-red-500/20 border border-red-500/50 text-red-300";
        feedback.innerText = `⚠️ ¡Ya escaneaste el alfajor "${PACKAGING_DB[itemId].name}"! No se puede repetir.`;
      } else {
        currentUser.collection.push(itemId);
        feedback.className = "w-full p-3 rounded-xl text-xs text-center font-bold bg-emerald-500/20 border border-emerald-500/50 text-emerald-300";
        feedback.innerText = `🎉 ¡Alfajor "${PACKAGING_DB[itemId].name}" añadido a tu colección!`;
        renderCollection();
      }
    }

    // Función para quitar participantes desde el panel maestro
    function removeParticipant(index) {
      simulatedParticipants.splice(index, 1);
      renderParticipants();
    }

    function renderParticipants() {
      const list = document.getElementById('participants-list');
      list.innerHTML = '';

      document.getElementById('participant-counter').innerText = `${simulatedParticipants.length} Participantes`;

      simulatedParticipants.forEach((p, index) => {
        const item = document.createElement('div');
        item.className = "p-2.5 rounded-xl bg-black/40 border border-white/5 flex justify-between items-center text-xs";
        
        item.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="${p.count > 0 ? 'text-emerald-400' : 'text-gray-500'} font-bold">●</span>
            <span class="font-bold text-amber-100">${p.name} <span class="text-[10px] text-amber-400 font-normal">(${p.count}/4)</span></span>
          </div>
          <button onclick="removeParticipant(${index})" class="bg-red-500/20 hover:bg-red-500/40 text-red-300 px-2 py-1 rounded border border-red-500/30 transition">
            ❌ Quitar
          </button>
        `;
        list.appendChild(item);
      });
    }

    function triggerRaffle() {
      const raffleBox = document.getElementById('raffle-box');
      const activeParticipants = simulatedParticipants.filter(p => p.count > 0);

      if (activeParticipants.length === 0) {
        raffleBox.innerHTML = `<p class="text-red-400 font-bold text-sm">No hay participantes válidos para sortear.</p>`;
        return;
      }

      let counter = 0;
      const interval = setInterval(() => {
        const randomP = activeParticipants[Math.floor(Math.random() * activeParticipants.length)];
        raffleBox.innerHTML = `
          <span class="text-4xl animate-bounce">🎁</span>
          <p class="text-xs text-amber-400 uppercase tracking-widest font-bold">Sorteando en vivo...</p>
          <h4 class="text-2xl font-black text-amber-200">${randomP.name}</h4>
        `;
        counter++;
        if (counter > 15) {
          clearInterval(interval);
          const winner = activeParticipants[Math.floor(Math.random() * activeParticipants.length)];
          raffleBox.innerHTML = `
            <div class="space-y-2">
              <span class="text-5xl">🏆</span>
              <p class="text-xs text-emerald-400 font-bold uppercase tracking-widest">¡Ganador/a del Sorteo!</p>
              <h4 class="text-3xl font-black text-amber-200">${winner.name}</h4>
            </div>
          `;
        }
      }, 100);
    }

    window.addEventListener('load', () => {
      renderCollection();
    });
  </script>
</body>
</html>